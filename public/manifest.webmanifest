{
  "name": "Kinetic Crew",
  "short_name": "Kinetic Crew",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#05050b",
  "theme_color": "#05050b",
  "description": "Kinetic Crew — crew events, updates and attendance",
  "icons": [
    {
      "src": "kinetic-crew-logo.jpg",
      "type": "image/jpeg",
      "purpose": "any"
    },
    {
      "src": "icon.svg",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./?share_target=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
